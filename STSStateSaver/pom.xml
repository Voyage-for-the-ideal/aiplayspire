<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>autoplay</groupId>
    <artifactId>SaveStateMod</artifactId>
    <version>1.6.1</version>
    <packaging>jar</packaging>
    <name>STS Save State Mod</name>
    <description>Serialize, save, and restore the full combat state of Slay the Spire at any point in battle: player HP/energy/draw/discard/exhaust piles, relics, potions, powers, orbs, stance, monster intents and abilities, RNG state, and active selection screens. Preserves floating-point creature coordinates, restores Gremlin Leader summon slots so mid-combat rewind retains vanilla minion placement and ordering, preserves zero-card exhaust selections such as Purity when restoring actions, encodes action-state creature references as board indices instead of live object graphs so serialization cannot be blown up by Gson reflection or throw on field conflicts, tolerates references to creatures that already left the board (such as a pending action targeting a monster that died before a selection screen froze the action queue) by restoring them as a null target instead of failing the snapshot, and exposes read-only monster intent/move-info/move-history accessors for battle evaluators. Enables instant rewind, deterministic diff-encoded state verification that ignores inactive selection controls and transient derived fields in played-card history, and high-throughput snapshots (10k+/s) for battle search and AI pipelines. Requires BaseMod. Adds read-only combat evaluation accessors and parses orb snapshots without initializing live orb instances. Accepts omitted optional card modifiers in Gson-serialized action envelopes so selection-screen snapshots round-trip correctly.</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <SlayTheSpire.version>11-30-2020</SlayTheSpire.version>
        <ModTheSpire.version>3.18.1</ModTheSpire.version>
        <BaseMod.version>5.32.0</BaseMod.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.megacrit.cardcrawl</groupId>
            <artifactId>slaythespire</artifactId>
            <version>${SlayTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../lib/desktop-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>basemod</groupId>
            <artifactId>BaseMod-root</artifactId>
            <version>${BaseMod.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/BaseMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated.cardcrawl</groupId>
            <artifactId>ModTheSpire</artifactId>
            <version>${ModTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../lib/ModTheSpire.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated.cardcrawl.mod</groupId>
            <artifactId>StSLib</artifactId>
            <version>1.3.2</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/StSLib.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${artifactId}</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>test-exhaust-action-state</id>
                        <phase>test</phase>
                        <configuration>
                            <target>
                                <java classname="savestate.actions.ExhaustActionStateRegressionTest"
                                      fork="true"
                                      failonerror="true">
                                    <sysproperty key="project.basedir" value="${project.basedir}"/>
                                    <classpath>
                                        <pathelement location="${project.build.testOutputDirectory}"/>
                                        <pathelement location="${project.build.outputDirectory}"/>
                                        <path refid="maven.test.classpath"/>
                                    </classpath>
                                </java>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>deploy-mod</id>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <copy file="target/${artifactId}.jar" tofile="../_ModTheSpire/mods/${artifactId}.jar"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>ModTheSpire.json</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>ModTheSpire.json</include>
                </includes>
            </resource>
        </resources>

    </build>

</project>
