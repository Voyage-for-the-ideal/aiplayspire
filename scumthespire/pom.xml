<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">

    <modelVersion>4.0.0</modelVersion>

    <groupId>autoplay</groupId>
    <artifactId>BattleAiMod</artifactId>
    <version>2.0.3</version>
    <packaging>jar</packaging>
    <name>Battle Ai Mod</name>
    <description>In-process native combat search for Windows x64. Start Steve runs the shared C++ simulator through JNI and executes guarded commands in the live game. No search server or external gateway.</description>

    <!-- 1.6 adds optional loopback native-backend readiness, guarded commands, and replay projections. -->
    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <SlayTheSpire.version>11-30-2020</SlayTheSpire.version>
        <ModTheSpire.version>3.18.1</ModTheSpire.version>
        <BaseMod.version>5.32.0</BaseMod.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.megacrit.cardcrawl</groupId>
            <artifactId>slaythespire</artifactId>
            <version>${SlayTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../lib/desktop-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated.cardcrawl</groupId>
            <artifactId>ModTheSpire</artifactId>
            <version>${ModTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../lib/ModTheSpire.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>savestatemod</groupId>
            <artifactId>savestatemod</artifactId>
            <version>1.1.0</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/SaveStateMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>LudicrousSpeed</groupId>
            <artifactId>LudicrousSpeed</artifactId>
            <version>1.1.11</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/LudicrousSpeed.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>30.1.1-jre</version>
        </dependency>
        <dependency>
            <groupId>basemod</groupId>
            <artifactId>BaseMod-root</artifactId>
            <version>${BaseMod.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/BaseMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>fightpredictor</groupId>
            <artifactId>FightPredictor</artifactId>
            <version>1.0.4</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/FightPredictor.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>BattleAiMod</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>2.4.2</version>
                <executions>
                    <execution>
                        <id>BattleAiMod</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>autoplay:BattleAiMod</artifact>
                                    <excludes>
                                        <exclude>battleaimod/battleai/BattleAiController*</exclude>
                                        <exclude>battleaimod/battleai/TurnNode*</exclude>
                                        <exclude>battleaimod/battleai/StateNode*</exclude>
                                        <exclude>battleaimod/battleai/playorder/**</exclude>
                                        <exclude>battleaimod/evaluation/**</exclude>
                                        <exclude>battleaimod/strategy/**</exclude>
                                        <exclude>battleaimod/ValueFunctions*</exclude>
                                        <exclude>battleaimod/patches/FightPredictorCompatibility*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>require-native-library</id><phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration><target>
                            <available file="${project.build.outputDirectory}/native/windows-x86_64/battle_jni.dll" property="native.present"/>
                            <fail unless="native.present" message="Build battle_engine/build.ps1 before packaging BattleAiMod."/>
                        </target></configuration>
                    </execution>
                    <execution>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <copy file="target/BattleAiMod.jar" tofile="../_ModTheSpire/mods/BattleAiMod.jar"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>${project.basedir}/../battle_engine/bin</directory>
                <targetPath>native/windows-x86_64</targetPath>
                <includes><include>battle_jni.dll</include></includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>ModTheSpire.json</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>ModTheSpire.json</include>
                </includes>
            </resource>
        </resources>

    </build>

</project>
