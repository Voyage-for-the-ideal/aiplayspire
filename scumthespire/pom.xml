<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">

    <modelVersion>4.0.0</modelVersion>

    <groupId>autoplay</groupId>
    <artifactId>BattleAiMod</artifactId>
    <version>1.10.0</version>
    <packaging>jar</packaging>
    <name>Battle Ai Mod</name>
    <description>Server/client integration for AI-controlled combat with a tactical battle evaluator: threat-aware target selection, non-linear survival risk, lethal/kill breakpoints, and interpretable per-component turn scoring, alongside immutable per-path replay snapshots, restart-safe replay cancellation, automatic battle startup, per-run state reset on run end for automatic consecutive runs, an all-lose death-path fallback that plays out the longest-surviving death line when no winning path exists, explicit empty-screen command diagnostics, a Defect (robot) synthetic server bootstrap, and a server-output log tee so server-side search crashes are diagnosable, a connection-accept loop so a dropped or failing request cannot silently kill the only networking thread, per-request crash isolation that logs the stack trace and answers the client with an explicit ERROR instead of stalling mid-battle, and a capped delayed auto-resend that replans from the live battle state after the client loses the search server or receives that ERROR. Adds four-character mechanism-aware evaluation and deterministic contextual ordering for plays, discard, exhaust, Scry, retrieval, and retention; shares stance, debuff, Intangible and Buffer-aware incoming damage between threat and survival. Adds an optional local native-search gateway with direct endpoint health checks, client port configuration, pre-execution public-state guards, single-action replanning, and opt-in real-engine replay projections. Persists external-backend selection in mod options and adds opt-in seeded-run fixtures and client wall-clock budgets for paired full-run comparisons. Uses native FAST/BALANCED/DEEP budgets (250/2000/10000 ms), preserving legacy Java baseline budgets and including stance in execution guards. Adds exact unlocked CardLibrary attack pools for native Foreign Influence and independent cardRng replay. Guards typed hand/grid/card-reward continuations before executing native selection commands, admits real Discovery card-reward selections (Skill/Attack/Power/Colorless Potion and the Discovery card) into native search, and keeps requesting native decisions while a combat selection screen is open instead of waiting for a manual click.</description>

    <!-- 1.6 adds optional loopback native-backend readiness, guarded commands, and replay projections. -->
    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <SlayTheSpire.version>11-30-2020</SlayTheSpire.version>
        <ModTheSpire.version>3.18.1</ModTheSpire.version>
        <BaseMod.version>5.32.0</BaseMod.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.megacrit.cardcrawl</groupId>
            <artifactId>slaythespire</artifactId>
            <version>${SlayTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../lib/desktop-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated.cardcrawl</groupId>
            <artifactId>ModTheSpire</artifactId>
            <version>${ModTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../lib/ModTheSpire.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>savestatemod</groupId>
            <artifactId>savestatemod</artifactId>
            <version>1.1.0</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/SaveStateMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>LudicrousSpeed</groupId>
            <artifactId>LudicrousSpeed</artifactId>
            <version>1.1.11</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/LudicrousSpeed.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>30.1.1-jre</version>
        </dependency>
        <dependency>
            <groupId>autoplay</groupId>
            <artifactId>CommunicationMod</artifactId>
            <version>1.1.0</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/CommunicationMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>basemod</groupId>
            <artifactId>BaseMod-root</artifactId>
            <version>${BaseMod.version}</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/BaseMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>fightpredictor</groupId>
            <artifactId>FightPredictor</artifactId>
            <version>1.0.4</version>
            <scope>system</scope>
            <systemPath>${basedir}/../_ModTheSpire/mods/FightPredictor.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>BattleAiMod</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>2.4.2</version>
                <executions>
                    <execution>
                        <id>BattleAiMod</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>autoplay:BattleAiMod</artifact>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <copy file="target/BattleAiMod.jar" tofile="../_ModTheSpire/mods/BattleAiMod.jar"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>ModTheSpire.json</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>ModTheSpire.json</include>
                </includes>
            </resource>
        </resources>

    </build>

</project>
