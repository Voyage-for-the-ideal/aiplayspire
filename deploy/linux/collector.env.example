# Shell-compatible, non-secret settings. Install as /etc/aiplayspire/collector.env.
AIP_ROOT=/home/ubuntu/aiplayspire
AIP_RUNTIME=/home/ubuntu/aiplayspire-runtime
AIP_PYTHON=/home/ubuntu/miniforge3/envs/spire/bin/python
AIP_PROFILE=Collector
AIP_PORT=5125
AIP_API_PORT=5000
AIP_BUDGET_MS=250
AIP_CHARACTER=IRONCLAD
AIP_ASCENSION=10
AIP_INTERVAL=1.0
# Start with one run. Use 0 only after the bounded-run acceptance passes.
AIP_MAX_RUNS=1
# Put LLM credentials in a separate /etc/aiplayspire/credentials.env (mode 0600).
# No credentials are copied from another project by the installer.
